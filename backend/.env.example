# ==============================================================================
# КОНФИГУРАЦИЯ ОКРУЖЕНИЯ ДЛЯ ХАКАТОНА АЛЬФА-БАНКА (ПРИМЕР)
# Скопируйте этот файл в .env и подставьте ваши актуальные ключи
# ==============================================================================

# Настройки PostgreSQL (Docker-контейнер)
POSTGRES_USER=alfa_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=alfa_insights_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Настройки безопасности FastAPI
# Сгенерируйте случайную строку, например, через: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_jwt_key_for_session_signing
# Список разрешенных адресов фронтенда через запятую (без пробелов)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API Ключи для Шлюза Моделей Альфа-Банка (Приложение 3)
ALFA_LLM_API_KEY=your_allocated_alfa_token_here
ALFA_LLM_BASE_URL=https://alfa-gate.ru

# Настройки логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
