# ==========================================
# 1. Системные файлы (OS Исключения)
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ==========================================
# 2. Бэкенд и ML (Python Исключения)
# ==========================================
# Кэш компиляции Python
**/__pycache__/
**/*.py[cod]
**/*$py.class

# Виртуальные окружения (локальные папки venv)
**/venv/
**/.venv/
**/env/
**/@env/
**/env.bak/

# Конфиденциальные данные (Локальные пароли и ключи)
**/.env
**/.env.local
**/.env.*.local

# Логи работы бэкенда
**/*.log

# Jupyter Notebooks кэш (актуально для ML)
**/.ipynb_checkpoints/

# ==========================================
# 3. Фронтенд (Node.js / React / Vue Исключения)
# ==========================================
# Зависимости фронтенда (самая тяжелая папка!)
**/node_modules/
**/jspm_packages/

# Папки сборки (production build)
**/dist/
**/build/
**/.next/
**/.nuxt/
**/.out/

# Кэш инструментов сборки
**/.turbo/
**/.parcel-cache/
**/.eslintcache/

# ==========================================
# 4. Специфика хакатона: Большие данные и Модели
# ==========================================
# Запрещаем загружать скачанные датасеты (CSV, JSON, базы данных)
**/data/*.csv
**/data/*.json
**/*.sqlite3
**/*.db

# Запрещаем загружать веса ML-моделей (они весят гигабайты)
**/*.onnx
**/*.pkl
**/*.pth
**/*.h5
**/*.bin
**/*.pt
**/*.ckpt
**/models/downloads/
backend/postgres_data/